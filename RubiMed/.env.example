# Copy this file to .env for local development and replace the sample secrets.
SECRET_KEY=replace-with-a-long-random-value
RESET_TOKEN_SECRET=replace-with-a-separate-long-random-value
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-local-mysql-password
DB_NAME=EHR_System
# Optional: needed only for password reset email delivery.
MAIL_USERNAME=
MAIL_PASSWORD=
FLASK_DEBUG=false
